APP_NAME=issuescope
ENVIRONMENT=local

# LLM settings — get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-3.5-turbo

# Cost per 1 000 tokens (USD) — update if OpenAI pricing changes
PRIMARY_COST_PER_1K_INPUT=0.000150
PRIMARY_COST_PER_1K_OUTPUT=0.000600
FALLBACK_COST_PER_1K_INPUT=0.000050
FALLBACK_COST_PER_1K_OUTPUT=0.000150

# Postgres (used from Week 3 onwards)
DATABASE_URL=postgresql+asyncpg://issuescope:issuescope@db:5432/issuescope
